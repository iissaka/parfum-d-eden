# ------------------------------------------------------------------
# Modèle de configuration — Le Parfum d'Eden
# Copier ce fichier en .env.local puis renseigner les valeurs.
# Ne jamais committer .env.local. Ne mettre aucun secret dans ce fichier.
# ------------------------------------------------------------------

# Adresse publique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sessions administrateur : 32 caractères minimum
# Générer avec : openssl rand -hex 32
SESSION_SECRET=

# Compte administrateur principal (bootstrap)
# Hash généré avec : npm run hash-password -- "votre-mot-de-passe-long"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Rôles possibles : owner | manager | preparer | reader
ADMIN_ROLE=owner

# Paiement à la livraison (solution de lancement). Mettre false pour le désactiver.
PAYMENT_COD_ENABLED=true

# Vérification des notifications de paiement (32 caractères minimum).
# Fourni par le prestataire de paiement lorsqu'il sera intégré.
PAYMENT_WEBHOOK_SECRET=

# Supabase (à renseigner lorsque l'adaptateur de données Supabase sera activé)
NEXT_PUBLIC_SUPABASE_URL=
# Clé service_role : serveur uniquement, jamais dans le navigateur
SUPABASE_SERVICE_ROLE_KEY=
